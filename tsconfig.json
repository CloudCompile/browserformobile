{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "node",
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"lib": [
			"ES2021",
			"DOM"
		],
		"baseUrl": ".",
		"paths": {
			"@anime/hls": [
				"../../packages/hls/src/index.d.ts",
				"./vendor/anime-hls.d.ts"
			],
			"@anime/catalogue": [
				"../../packages/catalogue/src/index.d.ts",
				"./vendor/anime-catalogue.d.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	]
}
